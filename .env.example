PORT=4173
ABLATRIX_MODE=fixture
ABLATRIX_DB=.data/ablatrix.sqlite
# The legacy research provider remains blocked until its charge/cap contracts are implemented.
# SAPIOM_API_KEY=
# SAPIOM_AGENT_SLUG=ablatrix-research
# ABLATRIX_SPEND_CAP_USD=

# Product QA feedback loop: /loop. The synthetic demo needs no Sapiom key.
# Local embeddings are downloaded once and cached under .data/models.
# ABLATRIX_LOOP_DB=.data/feedback-loop.sqlite
# ABLATRIX_RETRIEVAL_DB=.data/product-retrieval.sqlite
# ABLATRIX_FINAL_RETRIEVAL_DB=.data/product-final-retrieval.sqlite
# Optional exploratory live path, using the user's approved local spending plan.
# ABLATRIX_LOOP_LIVE=1
# SAPIOM_CREDENTIALS_FILE=/absolute/path/to/your/own/sapiom/credentials.json
# ABLATRIX_SPEND_CAP_USD=10
# ABLATRIX_LOOP_PRIOR_SPEND_USD=0
# ABLATRIX_LOOP_ALLOWANCE_USD=0.10
# ABLATRIX_LOOP_CALL_LIMIT=60
# ABLATRIX_LOOP_BUDGET_DB=.data/feedback-budget.sqlite
# Allowances are planning estimates. The loop does not claim settled provider charges.

# Optional Langfuse export: /loop > History > Sync to Langfuse.
# Choose your project's actual region or self-hosted origin; there is no default destination.
# ABLATRIX_LANGFUSE_ENABLED=1
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# ABLATRIX_LANGFUSE_DB=.data/langfuse-export.sqlite
# Sync sends eligible saved live questions, answers, evidence and policy metadata,
# plus confirmed human scores. Keys stay on the server. See docs/langfuse.md.
