{
  "name": "ablatrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "local": "npm run build && npm start",
    "replay": "node --import tsx server/replay.ts",
    "holdout": "node --import tsx server/holdout.ts",
    "pilot": "node --import tsx server/pilot-cli.ts"
  },
  "dependencies": {
    "@sapiom/agent": "0.14.2",
    "@sapiom/tools": "0.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
