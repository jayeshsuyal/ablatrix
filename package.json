{
  "name": "ablatrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode synthetic-demo",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts",
    "check:reliability": "node --import tsx scripts/reliability-check.ts",
    "test:e2e": "npm run build && playwright test",
    "test:demo": "npm run build:demo && playwright test --config playwright.demo.config.ts",
    "local": "npm run build && npm start",
    "demo": "npm run build:demo && node --import tsx server/index.ts --demo",
    "proof:development": "node --import tsx scripts/development-proof.ts",
    "proof:verify": "node --import tsx scripts/workspace-proof.ts",
    "replay": "node --import tsx server/replay.ts",
    "holdout": "node --import tsx server/holdout.ts",
    "pilot": "node --import tsx server/pilot-cli.ts",
    "compare": "node --import tsx server/context-comparison-cli.ts",
    "walkthrough": "node --import tsx scripts/correction-walkthrough.ts",
    "answer-policy:rehearse": "node --import tsx scripts/runtime-answer-policy-rehearsal.ts",
    "grader:calibration": "node --import tsx scripts/grader-calibration.ts",
    "grader:qualification": "node --import tsx scripts/grader-qualification.ts",
    "feedback:prepare": "node --env-file-if-exists=.env --import tsx server/feedback-prepare.ts",
    "feedback:retrieval-audit": "node --import tsx scripts/evaluate_product_retrieval.ts",
    "feedback:import-validation": "node --import tsx scripts/import_validation_packet.ts",
    "demo:backup": "node --import tsx scripts/demo-backup.ts backup",
    "demo:restore": "node --import tsx scripts/demo-backup.ts restore",
    "diagnosis:replay": "python3 scripts/replay-frozen-v2.py && node --import tsx scripts/verify-retrieval-diagnosis.ts",
    "diagnosis:mock": "node --import tsx scripts/three-context-mock.ts",
    "diagnosis:run": "node --import tsx scripts/retrieval-diagnosis.ts",
    "diagnosis:v5": "node --import tsx scripts/retrieval-diagnosis-v5.ts docs/evidence/retrieval-diagnosis-2026-10-19/semantic-supplement-v5-freeze-v2.json",
    "diagnosis:prepare-v5": "node --import tsx scripts/prepare-three-context-v5.ts",
    "diagnosis:live": "node --import tsx scripts/three-context-live.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@sapiom/agent": "0.14.2",
    "@sapiom/tools": "0.38.0",
    "jose": "6.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
